{
 "name": "plan-firearms-b",
 "about": "Test plan through the plan_firearms bot: the Demolitionist (the Rocket Launcher, its Fat Boy, Magic Missile and Quad orbs, Ordinance Hoarder's charges) and Assault.",
 "fixture": "town-paladin",
 "mods": [
  "core",
  "abyss",
  "architect",
  "bufftips",
  "campaign",
  "chatlinks",
  "classes",
  "colors",
  "deathrecap",
  "droptrade",
  "farming",
  "firearms",
  "fishing",
  "gambler",
  "goldpet",
  "groupcombo",
  "keys",
  "laststats",
  "legacy",
  "maps",
  "mercenary",
  "pets",
  "puzzles",
  "stash",
  "strongbox",
  "summons",
  "wavemode",
  "weapons",
  "weaponswap"
 ],
 "timeout": 600,
 "steps": [
  {
   "do": "console",
   "line": "e_cheats 1"
  },
  {
   "do": "console",
   "line": "show_chat"
  },
  {
   "do": "sleep",
   "seconds": 1
  },
  {
   "do": "bot",
   "bot": "plan_firearms",
   "kwargs": {
    "sections": "firearms_demolitionist"
   },
   "name": "firearms demolitionist",
   "expect": {
    "rpg_casts": true,
    "rpg_cost": true,
    "fatboy_blinds": true,
    "magic_missile_two_hits": true,
    "quad_four_missiles": true,
    "hoarder_passive": true,
    "hoarder_banks_charge": true,
    "hoarder_spends_charge": true,
    "demo_own_buttons": true
   }
  },
  {
   "do": "shot",
   "name": "firearms-demolitionist"
  },
  {
   "do": "bot",
   "bot": "plan_firearms",
   "kwargs": {
    "sections": "firearms_assault"
   },
   "name": "assault skills",
   "expect": {
    "adrenaline_passive": true,
    "burst_casts": true,
    "burst_cost": true,
    "assault_own_buttons": true
   }
  },
  {
   "do": "log_clean"
  }
 ]
}
