%include "players/skills_cost.inc"
<!--
	Elemental Bullets (base passive; the file and id keep Scavenger's name, which it
	replaced). Each gun shot has ele-chance to be a round of one of the four elements, its
	weapon damage all that element and without armor penetration (Elemental.as
	HWPFirearmsGunShot, round_elemental.inc). Skills, the shotgun and the turret's rounds are
	not gun shots. The chance and every orb are custom stats (Modifiers::CustomStat) that
	the script reads:
	- hwp-ele-chance: the passive's chance.
	- hwp-ele-<element>: a bullet-type orb (one at a time) adds that much weight to its
	  element, on top of 1 each: +30/60/100% likelihood.
	- hwp-ele-blind / hwp-ele-slow: poison rounds blind, ice rounds slow, 1 s a hit.
	- hwp-ele-stun: lightning rounds stun this many ms a hit.
	The riders add their time to what is left (HWPFirearmsBulletRider), up to 3 s.
	Each orb has its own modifiers slot (1-7), as sniper_focus.sval's orbs do.
-->
<dict>
	<string name="name">.skills.hwp_firearms.scavenger.name</string>
	<string name="type-name">.skills.type.passive</string>
	<string name="description">.skills.hwp_firearms.scavenger.desc</string>

	<array name="description-params">
				<array><s>chance</s><s>.skills.desc.params.chance</s><s>10%</s><s>20%</s><s>30%</s><s>40%</s><s>50%</s></array>
	</array>

	<array name="icon"><s>players/hwp/firearms/icons.png</s><i>100</i><vec4>216 0 24 24</vec4></array>

	<string name="id">hwp_fs_scavenger</string>
	<array name="tags"><s>passive</s></array>
	<int name="starting-level">0</int>

