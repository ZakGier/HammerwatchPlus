<!-- The rifle launcher's 40 mm shell. Generated by tools/make_bullet_art.py; edit that, not this. -->
<effect looping="true" wpos-track="3">
	<param name="angle" default="0" />
	<param name="height" default="0" />

	<sprite looping="true" origin="8 3.5" texture="./rounds.png" material="system/default.mats:shadow"
		pos-x="0"
		pos-y="+height"
		angle="angle">
		<frame time="80">0 40 16 8</frame>
		<frame time="80">16 40 16 8</frame>
	</sprite>
	<sprite looping="true" origin="8 3.5" texture="./rounds.png" material="system/default.mats:default"
		pos-x="0"
		pos-y="-height"
		angle="angle">
		<frame time="80">0 40 16 8</frame>
		<frame time="80">16 40 16 8</frame>
	</sprite>

	<particle_spawner
		spawn-rate="20"
		length="200"
		looping="true"
		ttl="rpick(350,800)"
		angle="0"
		pos="cos(angle)*-4;-height+sin(angle)*-4;0"
		color="120 120 120 120"
		color-mul="1;1;1;1"
		rot-speed="rpick(-2.2,2.2)"
		rot-damping="2"
		force-damping="rpick(1,3)">
		<behaviors>
			<spread_range radius="rpick(0,1)"/>
			<force_dir dir="cos(angle);sin(angle);0"/>
			<fade_to a="0" r="0" g="0" b="0" />
		</behaviors>
		<particle src="effects/subeffects/particles_grayscale.unit:smoke_1_tiny-grow"/>
		<particle src="effects/subeffects/particles_grayscale.unit:smoke_2_tiny-grow"/>
	</particle_spawner>

	<light pos-x="cos(angle)*2" pos-y="-height+sin(angle)*2">
		<sprite texture="effects/lights/light2_L.png">
			<frame time="800">0 0 128 128</frame>
		</sprite>
		<looping value="true" />
		<length value="150" />
		<cast-shadows value="false" />
		<size value="30" />
		<color-r value="0.15" />
		<color-g value="0.11" />
		<color-b value="0.06" />
		<color-a value="0"/>
	</light>
</effect>
