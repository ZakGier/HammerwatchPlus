		<string name="id">hwp_attack_rifle_gl</string>
		<string name="type">offhand</string>
		<array name="tags"><s>weapon</s><s>ranged</s><s>hwp_firearm</s><s>physical</s><s>hwp_explosive</s></array>

		<dict name="skill">
			<string name="class">Skills::PlayerSkillDirectional</string>
			<string name="anim">attack</string>
			<int name="anim-length">600</int>

			<int name="cooldown">1500</int>
			<float name="move-speed-mul">0.3</float>
			<ivec2 name="move-speed">0 600</ivec2>
			<float name="cast-speed-mul">1</float>
