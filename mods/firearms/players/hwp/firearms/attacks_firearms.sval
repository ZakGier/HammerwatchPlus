<loader order="-2">Item::ItemSkillDef::LoadMultiple</loader>
<!--
	Gun attacks. Every round spends one clip stack (stacks_firearms.sval:clip); a skill
	won't start without a round left, and an action list whose conditional fails stops
	there (IAction.as DoActions), so each list below checks what it needs before it shoots.
	The keywords of one "conditional" array must all hold; a "conditionals" list of arrays
	passes when any one array does (Conditional.as CheckConditionals), so the gates are flat.
	The Glocks read the other hand's marker buff (buffs_firearms.sval) to pair up.
-->

<array>
%defblock Spend N
				<dict>
					<string name="class">AddStacks</string>
					<string name="buff">players/hwp/firearms/stacks_firearms.sval:clip</string>
					<int name="stacks">-%%N%%</int>
					<bool name="target-self">true</bool>
				</dict>
%endblock
%defblock HasRound
		<array name="conditional">
			<s>buff stacks</s><s>players/hwp/firearms/stacks_firearms.sval:clip</s><s>ge</s><i>1</i>
		</array>
%endblock

	<dict>
		<string name="name">.skills.attacks.twohanded.hwp_rifle1.name</string>
		<string name="description">.skills.attacks.twohanded.hwp_rifle1.desc?dmg=160%</string>
		<array name="icon"><s>players/hwp/firearms/icons.png</s><i>100</i><vec4>48 48 24 24</vec4></array>
		<string name="id">hwp_attack_rifle</string>
		<string name="type">mainhand</string>
		<array name="tags"><s>weapon</s><s>ranged</s><s>hwp_firearm</s><s>physical</s></array>

		<dict name="skill">
			<string name="class">Skills::PlayerSkillDirectional</string>
			<string name="anim">attack</string>
			<int name="anim-length">560</int>

			<int name="cooldown">0</int>
			<float name="move-speed-mul">0.5</float>
			<ivec2 name="move-speed">0 560</ivec2>
			<float name="cast-speed-mul">1</float>
			<ivec2 name="blocking">0 560</ivec2>
			<int name="castpoint">0</int>
			<ivec2 name="update-aim">0 1</ivec2>
			<bool name="repeating">true</bool>
			<int name="mana-cost">0</int>
			%block HasRound

			<dict name="actions">
				<array name="cast">
					<dict>
						<string name="class">ShootProjectile</string>
						<string name="projectile">players/hwp/firearms/projectiles/rifle_round.unit</string>
						<int name="dist">5</int>
						<int name="spread">2</int>
					</dict>
					<dict>
						<string name="class">PlaySound</string>
						<string name="sound">event:/sfx/actors/humans/bandits/bandit_rogue/bandit_rogue_bomb_bounce</string>
					</dict>
					%block Spend 1
				</array>
			</dict>

			<array name="timeline">
				<i>0</i><s>cast</s>
			</array>
		</dict>
	</dict>
	<dict>
		<string name="name">.skills.attacks.twohanded.hwp_rifle1.name</string>
		<string name="description">.skills.attacks.twohanded.hwp_rifle1_epic.desc?dmg=200%</string>
		<array name="icon"><s>players/hwp/firearms/icons.png</s><i>100</i><vec4>48 48 24 24</vec4></array>
		<string name="id">hwp_attack_rifle_epic</string>
		<string name="type">mainhand</string>
		<array name="tags"><s>weapon</s><s>ranged</s><s>hwp_firearm</s><s>physical</s></array>

		<dict name="skill">
			<string name="class">Skills::PlayerSkillDirectional</string>
