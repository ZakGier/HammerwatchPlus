<!-- What a puff leaves in a room or a building (Joint.as SpawnHaze): a few slow fog banks
     (the vanilla fog texture) that thin out over a minute. Puffs stack: each adds one. -->
<effect looping="false" bounds="420 420">
	<sprite layer="100" looping="false" origin="64 64" texture="doodads/terrain/fog_animated.png" material="effects/effects.mats:default"
		num-sprites="6"
		pos-x="(rand(i)-0.5)*150"
		pos-y="(rand(i+7)-0.5)*100"
		scale-x="1.3+rand(i+3)*0.7+t*0.8"
		scale-y="1.3+rand(i+3)*0.7+t*0.8"
		angle="rand(i)*6+t*(rand(i+1)-0.5)*2"
		color-r="0.9"
		color-g="0.9"
		color-b="0.86"
		color-a="saturate(t*25)*(1-t)*0.18"
		>
		<frame time="60000">0 0 128 128</frame>
	</sprite>
</effect>
