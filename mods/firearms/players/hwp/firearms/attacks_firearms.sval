					</dict>
					<dict>
						<string name="class">HWPFirearmsGunShot</string>
						<string name="projectile">players/hwp/firearms/projectiles/rifle_round.unit</string>
						<string name="fire">players/hwp/firearms/projectiles/rifle_round_fire.unit</string>
						<string name="ice">players/hwp/firearms/projectiles/rifle_round_ice.unit</string>
						<string name="lightning">players/hwp/firearms/projectiles/rifle_round_lightning.unit</string>
						<string name="poison">players/hwp/firearms/projectiles/rifle_round_poison.unit</string>
						<int name="dist">22</int>
						<int name="spread">2</int>
					</dict>
					<dict>
