<!-- Explosive Reload: a thrown pistol magazine (smaller). Generated by tools/make_mag_art.py; edit that, not this. -->
<effect looping="true">
	<param name="angle" default="0" />
	<param name="height" default="0" />

	<sprite looping="true" origin="8 8" texture="./mags.png" material="system/default.mats:default"
		pos-x="0"
		pos-y="-height">
		<frame time="70">0 16 16 16</frame>
		<frame time="70">16 16 16 16</frame>
		<frame time="70">32 16 16 16</frame>
		<frame time="70">48 16 16 16</frame>
	</sprite>

	<particle_spawner
		spawn-rate="9"
		length="200"
		looping="true"
		ttl="rpick(120,280)"
		angle="0"
		pos="cos(angle)*-0;-height+sin(angle)*-0;0"
		color-mul="2.8;0.7;0.15;1"
		rot-speed="rpick(-2.2,2.2)"
		rot-damping="2"
		force-damping="rpick(1,3)">
		<behaviors>
			<spread_range radius="rpick(0,1.5)"/>
			<force_dir dir="cos(angle)*-0.2;sin(angle)*-0.2;0"/>
			<fade_to a="0" r="0" g="0" b="0" />
		</behaviors>
		<particle src="effects/subeffects/particles_speckles.unit:single_grey200_add_offset_2"/>
		<particle src="effects/subeffects/particles_speckles.unit:single_grey200_add"/>
	</particle_spawner>

	<light pos-x="cos(angle)*2" pos-y="-height+sin(angle)*2">
		<sprite texture="effects/lights/light2_L.png">
			<frame time="800">0 0 128 128</frame>
		</sprite>
		<looping value="true" />
		<length value="150" />
		<cast-shadows value="false" />
		<size value="24" />
		<color-r value="0.25" />
		<color-g value="0.07" />
		<color-b value="0.05" />
		<color-a value="0"/>
	</light>
</effect>
