<svals>
	<!-- Demo-only buffs for hand-play sessions (gamelab/scenarios/demo-*.json), applied with
	     "gl givebuff gamelab/buffs_demo.sval:<name> <ms>". Not shipped: gamelab-hands is a lab mod. -->

	<!-- fire rate x2: weapon attack speed, both hands (StatModifier.as SpeedMul); casts unchanged -->
	<dict name="fire_rate_x2">
		<bool name="debuff">false</bool>
		<int name="duration">3600000</int>

		<array name="modifiers">
			<dict>
				<string name="class">Modifiers::SpeedMul</string>
				<float name="attack-speed">2</float>
			</dict>
		</array>
	</dict>
</svals>
