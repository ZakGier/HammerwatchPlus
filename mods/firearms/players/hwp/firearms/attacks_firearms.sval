	<!--
		Glock, main hand (left click). Alone (shield, tome, empty off hand): one accurate
		round every 300 ms. With the off-hand Glock's marker: one round from each muzzle in turn,
		0.8 damage each (as alone) and a spread that blooms while held: two clips, two guns' affixes, less control.
		Each round leaves its own gun: the main hand's (right hand) 6 px right of the aim line
		(rotate-offset 0 6), the off hand's 6 px left (0 -6); measured by look-firearms-muzzles.
		Each is angled to cross the aim line 100 px out (converge, Elemental.as HWPFirearmsGunShot).
		Rounds start just past the gun's tip: dist 12 for a pistol, 22 for the rifle (ShootProjectile
		clamps it to a wall in between), and are drawn 11 px up, the gun's height.
	-->
	<dict>
		<string name="name">.skills.attacks.mainhand.hwp_glock.name</string>
		<string name="description">.skills.attacks.mainhand.hwp_glock.desc?dmg=80%&dual=80%</string>
		<array name="icon"><s>players/hwp/firearms/icons.png</s><i>100</i><vec4>72 48 24 24</vec4></array>
		<string name="id">hwp_attack_glock</string>
		<string name="type">mainhand</string>
		<array name="tags"><s>weapon</s><s>ranged</s><s>hwp_firearm</s><s>physical</s></array>

		<dict name="skill">
			<string name="class">HWPFirearmsGun</string>
			<string name="anim">attack</string>
			<int name="anim-length">600</int>
			<!-- alone (no off-hand Glock marker), one round every 300 ms instead of two a 600 ms cycle -->
			<int name="hwp-solo-length">300</int>
			<string name="hwp-solo-unless">glock_off</string>

			<int name="cooldown">0</int>
			<float name="move-speed-mul">0.6</float>
			<ivec2 name="move-speed">0 600</ivec2>
			<float name="cast-speed-mul">1</float>
			<ivec2 name="blocking">0 600</ivec2>
			<int name="castpoint">0</int>
			<ivec2 name="update-aim">0 600</ivec2>
			<bool name="repeating">true</bool>
			<int name="mana-cost">0</int>
			%block HasRound

			<dict name="actions">
				<array name="solo">
					<dict>
						<bool name="cond-target-self">true</bool>
						<array name="conditional">
							<s>buff</s><s>hasnt</s><s>players/hwp/firearms/buffs_firearms.sval:glock_off</s><s>buff stacks</s><s>players/hwp/firearms/stacks_firearms.sval:clip</s><s>ge</s><i>1</i>
						</array>
					</dict>
					<dict>
						<string name="class">HWPFirearmsGunShot</string>
						<string name="projectile">players/hwp/firearms/projectiles/glock_round.unit</string>
						<string name="fire">players/hwp/firearms/projectiles/glock_round_fire.unit</string>
						<string name="ice">players/hwp/firearms/projectiles/glock_round_ice.unit</string>
						<string name="lightning">players/hwp/firearms/projectiles/glock_round_lightning.unit</string>
						<string name="poison">players/hwp/firearms/projectiles/glock_round_poison.unit</string>
						<int name="dist">12</int>
						<vec2 name="offset">0 6</vec2>
						<bool name="rotate-offset">true</bool>
						<int name="converge">100</int>
						<int name="spread">3</int>
					</dict>
					<dict>
						<string name="class">HWPFirearmsSound</string>
						<string name="sound">event:/sfx/actors/humans/bandits/bandit_rogue/bandit_rogue_bomb_bounce</string>
					</dict>
					%block Spend 1
					<dict>
						<string name="class">HWPFirearmsLowClick</string>
						<int name="low">3</int>
					</dict>
				</array>
				<array name="left">
					<dict>
						<bool name="cond-target-self">true</bool>
						<array name="conditional">
							<s>buff</s><s>has</s><s>players/hwp/firearms/buffs_firearms.sval:glock_off</s><s>buff stacks</s><s>players/hwp/firearms/stacks_firearms.sval:clip</s><s>ge</s><i>1</i>
						</array>
					</dict>
					<dict>
						<string name="class">HWPFirearmsGunShot</string>
						<string name="projectile">players/hwp/firearms/projectiles/glock_round_dual.unit</string>
						<string name="fire">players/hwp/firearms/projectiles/glock_round_dual_fire.unit</string>
						<string name="ice">players/hwp/firearms/projectiles/glock_round_dual_ice.unit</string>
						<string name="lightning">players/hwp/firearms/projectiles/glock_round_dual_lightning.unit</string>
						<string name="poison">players/hwp/firearms/projectiles/glock_round_dual_poison.unit</string>
						<int name="dist">12</int>
						<vec2 name="offset">0 6</vec2>
						<bool name="rotate-offset">true</bool>
						<int name="converge">100</int>
						<!-- a plain spread (±2.5°): a spread dict's "min" is the least every round is thrown off
						     (ShootProjectile.as GetShootDir), so 4 sent both pistols wide of anything small -->
						<int name="spread">5</int>
					</dict>
					<dict>
						<string name="class">HWPFirearmsSound</string>
						<string name="sound">event:/sfx/actors/humans/bandits/bandit_rogue/bandit_rogue_bomb_bounce</string>
					</dict>
					%block Spend 1
					<dict>
						<string name="class">HWPFirearmsLowClick</string>
						<int name="low">6</int>
					</dict>
				</array>
				<array name="right">
					<dict>
						<bool name="cond-target-self">true</bool>
						<array name="conditional">
							<s>buff</s><s>has</s><s>players/hwp/firearms/buffs_firearms.sval:glock_off</s><s>buff stacks</s><s>players/hwp/firearms/stacks_firearms.sval:clip</s><s>ge</s><i>1</i>
						</array>
					</dict>
					<dict>
						<string name="class">HWPFirearmsGunShot</string>
						<string name="projectile">players/hwp/firearms/projectiles/glock_round_off.unit</string>
						<string name="fire">players/hwp/firearms/projectiles/glock_round_off_fire.unit</string>
						<string name="ice">players/hwp/firearms/projectiles/glock_round_off_ice.unit</string>
						<string name="lightning">players/hwp/firearms/projectiles/glock_round_off_lightning.unit</string>
						<string name="poison">players/hwp/firearms/projectiles/glock_round_off_poison.unit</string>
						<int name="dist">12</int>
						<vec2 name="offset">0 -6</vec2>
						<bool name="rotate-offset">true</bool>
						<int name="converge">100</int>
						<!-- a plain spread (±2.5°): a spread dict's "min" is the least every round is thrown off
						     (ShootProjectile.as GetShootDir), so 4 sent both pistols wide of anything small -->
						<int name="spread">5</int>
					</dict>
					<dict>
						<string name="class">HWPFirearmsSound</string>
						<string name="sound">event:/sfx/actors/humans/bandits/bandit_rogue/bandit_rogue_bomb_bounce</string>
					</dict>
					%block Spend 1
					<dict>
						<string name="class">HWPFirearmsLowClick</string>
						<int name="low">6</int>
					</dict>
				</array>
			</dict>

			<array name="timeline">
				<i>0</i><s>solo</s>
				<i>0</i><s>left</s>
				<i>300</i><s>right</s>
			</array>
		</dict>
	</dict>

	<!--
		Glock, off hand (right click). With the main-hand Glock's marker: both guns at once,
		two rounds and a wide spread - the burst. Alone (any other main hand): one round.
	-->
	<dict>
		<string name="name">.skills.attacks.offhand.hwp_glock.name</string>
		<string name="description">.skills.attacks.offhand.hwp_glock.desc?dmg=80%</string>
		<array name="icon"><s>players/hwp/firearms/icons.png</s><i>100</i><vec4>96 48 24 24</vec4></array>
		<string name="id">hwp_attack_glock_off</string>
		<string name="type">offhand</string>
		<array name="tags"><s>weapon</s><s>ranged</s><s>hwp_firearm</s><s>physical</s></array>

		<dict name="skill">
			<string name="class">HWPFirearmsGun</string>
			<string name="anim">offhand-handcrossbow</string>
			<int name="anim-length">520</int>

			<int name="cooldown">0</int>
			<float name="move-speed-mul">0.4</float>
			<ivec2 name="move-speed">0 520</ivec2>
			<float name="cast-speed-mul">1</float>
			<ivec2 name="blocking">0 520</ivec2>
			<int name="castpoint">0</int>
			<ivec2 name="update-aim">0 1</ivec2>
			<bool name="repeating">true</bool>
			<int name="mana-cost">0</int>
			%block HasRound

			<dict name="actions">
				<array name="both">
					<dict>
						<bool name="cond-target-self">true</bool>
						<array name="conditional">
							<s>buff</s><s>has</s><s>players/hwp/firearms/buffs_firearms.sval:glock_main</s><s>buff stacks</s><s>players/hwp/firearms/stacks_firearms.sval:clip</s><s>ge</s><i>2</i>
						</array>
					</dict>
					<dict>
						<string name="class">HWPFirearmsGunShot</string>
						<string name="projectile">players/hwp/firearms/projectiles/glock_round_dual.unit</string>
						<string name="fire">players/hwp/firearms/projectiles/glock_round_dual_fire.unit</string>
						<string name="ice">players/hwp/firearms/projectiles/glock_round_dual_ice.unit</string>
						<string name="lightning">players/hwp/firearms/projectiles/glock_round_dual_lightning.unit</string>
						<string name="poison">players/hwp/firearms/projectiles/glock_round_dual_poison.unit</string>
						<int name="dist">12</int>
						<vec2 name="offset">0 6</vec2>
						<bool name="rotate-offset">true</bool>
						<int name="converge">100</int>
						<int name="spread">18</int>
					</dict>
					<dict>
						<string name="class">HWPFirearmsGunShot</string>
						<string name="projectile">players/hwp/firearms/projectiles/glock_round_off.unit</string>
						<string name="fire">players/hwp/firearms/projectiles/glock_round_off_fire.unit</string>
						<string name="ice">players/hwp/firearms/projectiles/glock_round_off_ice.unit</string>
						<string name="lightning">players/hwp/firearms/projectiles/glock_round_off_lightning.unit</string>
						<string name="poison">players/hwp/firearms/projectiles/glock_round_off_poison.unit</string>
						<int name="dist">12</int>
						<vec2 name="offset">0 -6</vec2>
						<bool name="rotate-offset">true</bool>
						<int name="converge">100</int>
						<int name="spread">18</int>
					</dict>
					<dict>
						<string name="class">HWPFirearmsSound</string>
						<string name="sound">event:/sfx/actors/humans/bandits/bandit_rogue/bandit_rogue_bomb_bounce</string>
					</dict>
					%block Spend 2
					<dict>
						<string name="class">HWPFirearmsLowClick</string>
						<int name="low">6</int>
					</dict>
				</array>
				<array name="solo">
					<dict>
						<bool name="cond-target-self">true</bool>
						<array name="conditional">
							<s>buff</s><s>hasnt</s><s>players/hwp/firearms/buffs_firearms.sval:glock_main</s>
						</array>
					</dict>
					<dict>
						<string name="class">SpawnEffect</string>
						<string name="effect">effects/generic/attacks/hand_crossbow_quickshot.effect</string>
						<bool name="attach-to-owner">true</bool>
						<bool name="send-angle">true</bool>
					</dict>
					<dict>
						<string name="class">HWPFirearmsGunShot</string>
						<string name="projectile">players/hwp/firearms/projectiles/glock_round_off.unit</string>
						<string name="fire">players/hwp/firearms/projectiles/glock_round_off_fire.unit</string>
						<string name="ice">players/hwp/firearms/projectiles/glock_round_off_ice.unit</string>
						<string name="lightning">players/hwp/firearms/projectiles/glock_round_off_lightning.unit</string>
						<string name="poison">players/hwp/firearms/projectiles/glock_round_off_poison.unit</string>
						<int name="dist">12</int>
						<vec2 name="offset">0 -6</vec2>
						<bool name="rotate-offset">true</bool>
						<int name="converge">100</int>
						<int name="spread">4</int>
					</dict>
					<dict>
						<string name="class">HWPFirearmsSound</string>
						<string name="sound">event:/sfx/actors/humans/bandits/bandit_rogue/bandit_rogue_bomb_bounce</string>
					</dict>
					%block Spend 1
					<dict>
						<string name="class">HWPFirearmsLowClick</string>
						<int name="low">3</int>
					</dict>
				</array>
				<!-- both pistols out with one round left: the off hand fires it alone -->
				<array name="last">
					<dict>
						<bool name="cond-target-self">true</bool>
						<array name="conditional">
							<s>buff</s><s>has</s><s>players/hwp/firearms/buffs_firearms.sval:glock_main</s><s>buff stacks</s><s>players/hwp/firearms/stacks_firearms.sval:clip</s><s>lt</s><i>2</i>
						</array>
					</dict>
					<dict>
						<string name="class">SpawnEffect</string>
						<string name="effect">effects/generic/attacks/hand_crossbow_quickshot.effect</string>
						<bool name="attach-to-owner">true</bool>
						<bool name="send-angle">true</bool>
					</dict>
					<dict>
						<string name="class">HWPFirearmsGunShot</string>
						<string name="projectile">players/hwp/firearms/projectiles/glock_round_off.unit</string>
						<string name="fire">players/hwp/firearms/projectiles/glock_round_off_fire.unit</string>
						<string name="ice">players/hwp/firearms/projectiles/glock_round_off_ice.unit</string>
						<string name="lightning">players/hwp/firearms/projectiles/glock_round_off_lightning.unit</string>
						<string name="poison">players/hwp/firearms/projectiles/glock_round_off_poison.unit</string>
						<int name="dist">12</int>
						<vec2 name="offset">0 -6</vec2>
						<bool name="rotate-offset">true</bool>
						<int name="converge">100</int>
						<int name="spread">4</int>
					</dict>
					<dict>
						<string name="class">HWPFirearmsSound</string>
						<string name="sound">event:/sfx/actors/humans/bandits/bandit_rogue/bandit_rogue_bomb_bounce</string>
					</dict>
					%block Spend 1
					<dict>
						<string name="class">HWPFirearmsLowClick</string>
						<int name="low">6</int>
					</dict>
				</array>
			</dict>

			<array name="timeline">
				<!-- last before both: at one round it spends it, so both (2 or more) can't follow -->
				<i>0</i><s>last</s>
				<i>0</i><s>both</s>
				<i>0</i><s>solo</s>
			</array>
		</dict>
	</dict>
</array>
