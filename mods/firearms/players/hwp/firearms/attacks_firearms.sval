	<!--
		Glock, main hand (left click). Alone (shield, tome, empty off hand): two accurate
		rounds a cycle. With the off-hand Glock's marker: one round from each muzzle in turn,
		0.9 damage each and a spread that blooms while held - less control, a bit less DPS.
	-->
	<dict>
		<string name="name">.skills.attacks.mainhand.hwp_glock.name</string>
		<string name="description">.skills.attacks.mainhand.hwp_glock.desc?dmg=100%&dual=90%</string>
		<array name="icon"><s>players/hwp/firearms/icons.png</s><i>100</i><vec4>72 48 24 24</vec4></array>
		<string name="id">hwp_attack_glock</string>
		<string name="type">mainhand</string>
		<array name="tags"><s>weapon</s><s>ranged</s><s>hwp_firearm</s><s>physical</s></array>

		<dict name="skill">
			<string name="class">Skills::PlayerSkillDirectional</string>
			<string name="anim">attack</string>
			<int name="anim-length">520</int>

			<int name="cooldown">0</int>
			<float name="move-speed-mul">0.6</float>
			<ivec2 name="move-speed">0 520</ivec2>
			<float name="cast-speed-mul">1</float>
			<ivec2 name="blocking">0 520</ivec2>
			<int name="castpoint">0</int>
			<ivec2 name="update-aim">0 520</ivec2>
			<bool name="repeating">true</bool>
			<int name="mana-cost">0</int>
			%block HasRound

			<dict name="actions">
				<array name="solo">
					<dict>
						<bool name="cond-target-self">true</bool>
						<array name="conditional">
							<s>buff</s><s>hasnt</s><s>players/hwp/firearms/buffs_firearms.sval:glock_off</s><s>buff stacks</s><s>players/hwp/firearms/stacks_firearms.sval:clip</s><s>ge</s><i>1</i>
						</array>
					</dict>
					<dict>
						<string name="class">ShootProjectile</string>
						<string name="projectile">players/hwp/firearms/projectiles/glock_round.unit</string>
						<int name="dist">5</int>
						<int name="spread">3</int>
					</dict>
					<dict>
						<string name="class">PlaySound</string>
						<string name="sound">event:/sfx/player/classes/rogue/grenade/grenade_bounce</string>
					</dict>
					%block Spend 1
				</array>
				<array name="left">
					<dict>
						<bool name="cond-target-self">true</bool>
						<array name="conditional">
							<s>buff</s><s>has</s><s>players/hwp/firearms/buffs_firearms.sval:glock_off</s><s>buff stacks</s><s>players/hwp/firearms/stacks_firearms.sval:clip</s><s>ge</s><i>1</i>
						</array>
					</dict>
					<dict>
						<string name="class">ShootProjectile</string>
						<string name="projectile">players/hwp/firearms/projectiles/glock_round_dual.unit</string>
						<int name="dist">5</int>
						<vec2 name="offset">0 -2</vec2>
						<bool name="rotate-offset">true</bool>
						<dict name="spread"><int name="min">4</int><int name="max">12</int><int name="time">1500</int></dict>
					</dict>
					<dict>
						<string name="class">PlaySound</string>
						<string name="sound">event:/sfx/player/classes/rogue/grenade/grenade_bounce</string>
					</dict>
					%block Spend 1
				</array>
				<array name="right">
					<dict>
						<bool name="cond-target-self">true</bool>
						<array name="conditional">
							<s>buff</s><s>has</s><s>players/hwp/firearms/buffs_firearms.sval:glock_off</s><s>buff stacks</s><s>players/hwp/firearms/stacks_firearms.sval:clip</s><s>ge</s><i>1</i>
						</array>
					</dict>
					<dict>
						<string name="class">ShootProjectile</string>
						<string name="projectile">players/hwp/firearms/projectiles/glock_round_off.unit</string>
						<int name="dist">5</int>
						<vec2 name="offset">0 2</vec2>
						<bool name="rotate-offset">true</bool>
						<dict name="spread"><int name="min">4</int><int name="max">12</int><int name="time">1500</int></dict>
					</dict>
					<dict>
						<string name="class">PlaySound</string>
						<string name="sound">event:/sfx/player/classes/rogue/grenade/grenade_bounce</string>
					</dict>
					%block Spend 1
				</array>
			</dict>

			<array name="timeline">
				<i>0</i><s>solo</s>
				<i>0</i><s>left</s>
				<i>260</i><s>solo</s>
				<i>260</i><s>right</s>
			</array>
		</dict>
	</dict>

	<!--
		Glock, off hand (right click). With the main-hand Glock's marker: both guns at once,
		two rounds and a wide spread - the burst. Alone (any other main hand): one round.
	-->
	<dict>
		<string name="name">.skills.attacks.offhand.hwp_glock.name</string>
		<string name="description">.skills.attacks.offhand.hwp_glock.desc?dmg=90%</string>
		<array name="icon"><s>players/hwp/firearms/icons.png</s><i>100</i><vec4>96 48 24 24</vec4></array>
		<string name="id">hwp_attack_glock_off</string>
		<string name="type">offhand</string>
		<array name="tags"><s>weapon</s><s>ranged</s><s>hwp_firearm</s><s>physical</s></array>

		<dict name="skill">
			<string name="class">Skills::PlayerSkillDirectional</string>
			<string name="anim">offhand-handcrossbow</string>
			<int name="anim-length">520</int>

			<int name="cooldown">0</int>
			<float name="move-speed-mul">0.4</float>
			<ivec2 name="move-speed">0 520</ivec2>
			<float name="cast-speed-mul">1</float>
			<ivec2 name="blocking">0 520</ivec2>
			<int name="castpoint">0</int>
			<ivec2 name="update-aim">0 1</ivec2>
			<bool name="repeating">true</bool>
			<int name="mana-cost">0</int>
			%block HasRound

			<dict name="actions">
				<array name="both">
					<dict>
						<bool name="cond-target-self">true</bool>
						<array name="conditional">
							<s>buff</s><s>has</s><s>players/hwp/firearms/buffs_firearms.sval:glock_main</s><s>buff stacks</s><s>players/hwp/firearms/stacks_firearms.sval:clip</s><s>ge</s><i>2</i>
						</array>
					</dict>
					<dict>
						<string name="class">ShootProjectile</string>
						<string name="projectile">players/hwp/firearms/projectiles/glock_round_dual.unit</string>
						<int name="dist">5</int>
						<vec2 name="offset">0 -2</vec2>
						<bool name="rotate-offset">true</bool>
						<int name="spread">18</int>
					</dict>
					<dict>
						<string name="class">ShootProjectile</string>
						<string name="projectile">players/hwp/firearms/projectiles/glock_round_off.unit</string>
						<int name="dist">5</int>
						<vec2 name="offset">0 2</vec2>
						<bool name="rotate-offset">true</bool>
						<int name="spread">18</int>
					</dict>
					<dict>
						<string name="class">PlaySound</string>
						<string name="sound">event:/sfx/player/classes/rogue/grenade/grenade_bounce</string>
					</dict>
					%block Spend 2
				</array>
				<array name="solo">
					<dict>
						<bool name="cond-target-self">true</bool>
						<array name="conditional">
							<s>buff</s><s>hasnt</s><s>players/hwp/firearms/buffs_firearms.sval:glock_main</s>
						</array>
					</dict>
					<dict>
						<string name="class">SpawnEffect</string>
						<string name="effect">effects/generic/attacks/hand_crossbow_quickshot.effect</string>
						<bool name="attach-to-owner">true</bool>
						<bool name="send-angle">true</bool>
					</dict>
					<dict>
						<string name="class">ShootProjectile</string>
						<string name="projectile">players/hwp/firearms/projectiles/glock_round_off.unit</string>
						<int name="dist">5</int>
						<int name="spread">4</int>
					</dict>
					<dict>
						<string name="class">PlaySound</string>
						<string name="sound">event:/sfx/player/classes/rogue/grenade/grenade_bounce</string>
					</dict>
					%block Spend 1
				</array>
			</dict>

			<array name="timeline">
				<i>0</i><s>both</s>
				<i>0</i><s>solo</s>
			</array>
		</dict>
	</dict>
</array>
