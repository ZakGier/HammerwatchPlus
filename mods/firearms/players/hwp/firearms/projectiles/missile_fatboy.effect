<!-- Missile: fatboy. Generated by tools/make_bullet_art.py; edit that, not this. -->
<effect looping="true" wpos-track="3">
	<param name="angle" default="0" />
	<param name="height" default="0" />

	<sprite looping="true" origin="24 8" texture="./rounds.png" material="system/default.mats:shadow"
		pos-x="0"
		pos-y="+height"
		angle="angle">
		<frame time="50">64 16 32 16</frame>
		<frame time="50">96 16 32 16</frame>
	</sprite>
	<sprite looping="true" origin="24 8" texture="./rounds.png" material="system/default.mats:default"
		pos-x="0"
		pos-y="-height"
		angle="angle">
		<frame time="50">64 16 32 16</frame>
		<frame time="50">96 16 32 16</frame>
	</sprite>

	<particle_spawner
		spawn-rate="24"
		length="200"
		looping="true"
		ttl="rpick(300,700)"
		angle="0"
		pos="cos(angle)*-15;-height+sin(angle)*-15;0"
		color-mul="2.8;0.6;0.1;1"
		rot-speed="rpick(-2.2,2.2)"
		rot-damping="2"
		force-damping="rpick(1,3)">
		<behaviors>
			<spread_range radius="rpick(0,1.5)"/>
			<force_dir dir="cos(angle)*-0.2;sin(angle)*-0.2;0"/>
			<fade_to a="0" r="0" g="0" b="0" />
		</behaviors>
		<particle src="effects/subeffects/particles_speckles.unit:single_grey200_add_offset_2"/>
		<particle src="effects/subeffects/particles_speckles.unit:single_grey200_add"/>
	</particle_spawner>

	<particle_spawner
		spawn-rate="40"
		length="200"
		looping="true"
		ttl="rpick(350,800)"
		angle="0"
		pos="cos(angle)*-15;-height+sin(angle)*-15;0"
		color="155 155 155 155"
		color-mul="1;1;1;1"
		rot-speed="rpick(-2.2,2.2)"
		rot-damping="2"
		force-damping="rpick(1,3)">
		<behaviors>
			<spread_range radius="rpick(0,1)"/>
			<force_dir dir="cos(angle);sin(angle);0"/>
			<fade_to a="0" r="0" g="0" b="0" />
		</behaviors>
		<particle src="effects/subeffects/particles_grayscale.unit:smoke_1_tiny-grow"/>
		<particle src="effects/subeffects/particles_grayscale.unit:smoke_2_tiny-grow"/>
	</particle_spawner>

	<trail texture="special/empty.png" material="system/default.mats:default-simple">
		<pos-x value="wposx(i)+cos(angle)*-15" />
		<pos-y value="-height+(wposy(i))+sin(angle)*-15" />
		<angle value="angle"/>
		<length value="1000" />
		<looping value="true" />
		<segments value="3" />
		<size value="2-((2/3)*i)" />
		<uv-x value="0" />
		<uv-y value="0" />
		<color-r value="1" />
		<color-g value="0.7" />
		<color-b value="0.35" />
		<color-a value="0.5-i*(0.167)" />
	</trail>

	<light pos-x="cos(angle)*2" pos-y="-height+sin(angle)*2">
		<sprite texture="effects/lights/light2_L.png">
			<frame time="800">0 0 128 128</frame>
		</sprite>
		<looping value="true" />
		<length value="150" />
		<cast-shadows value="false" />
		<size value="70" />
		<color-r value="0.35" />
		<color-g value="0.19" />
		<color-b value="0.07" />
		<color-a value="0"/>
	</light>
</effect>
