%include "players/skills_cost.inc"
<!--
	Ordinance Hoarder (Demolitionist passive). The Frag Grenade, the rifle's Grenade Launcher
	(either rifle's) and the Rocket Launcher cool down faster (cooldown-mul 1/1.1 .. 1/1.5)
	and store charges while they sit ready (stacks_firearms.sval grenade_charges /
	gl_charges / rocket_charges, max raised here). The module
	script (Combat.as HoardedSkill) adds a charge for every cooldown's worth of time the
	skill waits ready, and spends one to clear the cooldown right after a cast.
-->
<dict>
	<string name="name">.skills.hwp_firearms.hoarder.name</string>
	<string name="type-name">.skills.type.passive</string>
	<string name="description">.skills.hwp_firearms.hoarder.desc</string>

	<array name="description-params">
		<array><s>cooldown</s><s>.skills.desc.params.hwp_charge_rate</s><s>+10%</s><s>+20%</s><s>+30%</s><s>+40%</s><s>+50%</s></array>
		<array><s>stacks-max</s><s>.skills.desc.params.hwp_charges</s><s>+1</s><s>+1</s><s>+2</s><s>+2</s><s>+3</s></array>
	</array>

	<array name="icon"><s>players/hwp/firearms/icons.png</s><i>100</i><vec4>192 0 24 24</vec4></array>

	<string name="id">hwp_fs_hoarder</string>
	<array name="tags"><s>passive</s></array>
	<int name="starting-level">1</int>

	<dict name="skill">
		<int name="skill-cost">SKILLCOSTMASTERYLEVEL_1</int>
		<string name="class">Skills::PassiveSkill</string>
		<dict name="binds">
			<float name="hoard-cd">0.9091</float>
			<ivec2 name="hoard-max">1 1</ivec2>
		</dict>
		<array name="modifiers">
			<array>
				<dict>
					<string name="class">Modifiers::BaseSkillModifier</string>
					<string name="skill-id">hwp_fs_frag</string>
					<string name="cooldown-mul-bind">hoard-cd</string>
				</dict>
				<dict>
					<string name="class">Modifiers::BaseSkillModifier</string>
					<string name="skill-id">hwp_fs_rpg</string>
					<string name="cooldown-mul-bind">hoard-cd</string>
				</dict>
				<dict>
					<string name="class">Modifiers::BaseSkillModifier</string>
					<string name="skill-id">hwp_attack_rifle_gl</string>
					<string name="cooldown-mul-bind">hoard-cd</string>
				</dict>
				<dict>
					<string name="class">Modifiers::BaseSkillModifier</string>
					<string name="skill-id">hwp_attack_rifle_gl_epic</string>
					<string name="cooldown-mul-bind">hoard-cd</string>
				</dict>
				<dict>
					<string name="class">Modifiers::ModifyStack</string>
					<string name="buff">players/hwp/firearms/stacks_firearms.sval:grenade_charges</string>
					<string name="add-max-bind">hoard-max</string>
				</dict>
				<dict>
					<string name="class">Modifiers::ModifyStack</string>
					<string name="buff">players/hwp/firearms/stacks_firearms.sval:rocket_charges</string>
					<string name="add-max-bind">hoard-max</string>
				</dict>
				<dict>
					<string name="class">Modifiers::ModifyStack</string>
					<string name="buff">players/hwp/firearms/stacks_firearms.sval:gl_charges</string>
					<string name="add-max-bind">hoard-max</string>
				</dict>
			</array>
		</array>
	</dict>

	<array name="upgrades">
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_2</int>
			<dict name="binds">
				<float name="hoard-cd">0.8333</float>
				<ivec2 name="hoard-max">1 1</ivec2>
			</dict>
		</dict>
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_3</int>
			<dict name="binds">
				<float name="hoard-cd">0.7692</float>
				<ivec2 name="hoard-max">2 2</ivec2>
			</dict>
		</dict>
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_4</int>
			<dict name="binds">
				<float name="hoard-cd">0.7143</float>
				<ivec2 name="hoard-max">2 2</ivec2>
			</dict>
		</dict>
		<dict>
			<int name="skill-cost">SKILLCOSTMASTERYLEVEL_5</int>
			<dict name="binds">
				<float name="hoard-cd">0.6667</float>
				<ivec2 name="hoard-max">3 3</ivec2>
			</dict>
		</dict>
	</array>

	<array name="modifier-skills">
		<!-- Overpacked Explosives: every skill tagged hwp_explosive (the grenades, the rocket,
		     the rifle's grenade launcher, Explosive Reload) deals more. -->
		<dict>
			<string name="name">.skills.hwp_firearms.hoarder_overpacked.name</string>
			<string name="description">.skills.hwp_firearms.hoarder_overpacked.desc</string>

			<array name="description-params">
				<array><s>damage</s><s>.skills.desc.params.hwp_explosive_dmg</s><s>+15%</s><s>+25%</s></array>
			</array>

			<array name="icon"><s>players/hwp/firearms/icons.png</s><i>100</i><vec4>24 48 24 24</vec4></array>

			<array name="tags"><s>passive</s></array>
			<string name="id">hwp_fs_hoarder_overpacked</string>
			<string name="quality">uncommon</string>
			<int name="starting-level">0</int>

			<dict name="skill">
				<dict name="binds">
					<float name="overpacked-mul">1.15</float>
				</dict>
				<array name="modifiers">
					<array>
						<null />
					</array>
					<array>
						<dict>
							<string name="class">Modifiers::BaseSkillModifier</string>
							<array name="skill-tags"><s>hwp_explosive</s></array>
							<string name="damage-mul-bind">overpacked-mul</string>
						</dict>
					</array>
				</array>
			</dict>

			<!-- the planner has uncommon for both levels -->
			<array name="upgrades">
				<dict>
					<string name="quality">uncommon</string>
					<dict name="binds">
						<float name="overpacked-mul">1.25</float>
					</dict>
				</dict>
			</array>
		</dict>

		<!-- Elemental Shrapnel: raises the hwp-shrapnel custom stat that every explosive
		     reads as its fire, ice, lightning and poison penetration (shrapnel.inc). -->
		<dict>
			<string name="name">.skills.hwp_firearms.hoarder_shrapnel.name</string>
			<string name="description">.skills.hwp_firearms.hoarder_shrapnel.desc</string>

			<array name="description-params">
				<array><s>pen</s><s>.skills.desc.params.ele_pen</s><s>+6%</s><s>+12%</s></array>
			</array>

			<array name="icon"><s>players/hwp/firearms/icons.png</s><i>100</i><vec4>0 48 24 24</vec4></array>

			<array name="tags"><s>passive</s></array>
			<string name="id">hwp_fs_hoarder_shrapnel</string>
			<string name="quality">uncommon</string>
			<int name="starting-level">0</int>

			<dict name="skill">
				<dict name="binds">
					<float name="shrapnel-pen">0.06</float>
				</dict>
				<array name="modifiers">
					<array>
						<null />
					</array>
					<array>
						<null />
					</array>
					<array>
						<dict>
							<string name="class">Modifiers::CustomStat</string>
							<string name="name">hwp-shrapnel</string>
							<string name="add-bind">shrapnel-pen</string>
						</dict>
					</array>
				</array>
			</dict>

			<array name="upgrades">
				<dict>
					<string name="quality">rare</string>
					<dict name="binds">
						<float name="shrapnel-pen">0.12</float>
					</dict>
				</dict>
			</array>
		</dict>
	</array>
</dict>
