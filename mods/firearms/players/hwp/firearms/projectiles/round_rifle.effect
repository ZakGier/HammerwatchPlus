<!-- A rifle/turret round, plain. Generated by tools/make_bullet_art.py; edit that, not this. -->
<effect looping="true" wpos-track="3">
	<param name="angle" default="0" />
	<param name="height" default="0" />

	<sprite looping="true" origin="9 3.5" texture="./rounds.png" material="system/default.mats:shadow"
		pos-x="0"
		pos-y="+height"
		angle="angle">
		<frame time="60">0 0 16 8</frame>
		<frame time="60">16 0 16 8</frame>
	</sprite>
	<sprite looping="true" origin="9 3.5" texture="./rounds.png" material="system/default.mats:default"
		pos-x="0"
		pos-y="-height"
		angle="angle">
		<frame time="60">0 0 16 8</frame>
		<frame time="60">16 0 16 8</frame>
	</sprite>

	<trail texture="special/empty.png" material="system/default.mats:default-simple">
		<pos-x value="wposx(i)+cos(angle)*-4" />
		<pos-y value="-height+(wposy(i))+sin(angle)*-4" />
		<angle value="angle"/>
		<length value="1000" />
		<looping value="true" />
		<segments value="3" />
		<size value="1.6-((1.6/3)*i)" />
		<uv-x value="0" />
		<uv-y value="0" />
		<color-r value="1" />
		<color-g value="0.82" />
		<color-b value="0.5" />
		<color-a value="0.55-i*(0.183)" />
	</trail>

	<light pos-x="cos(angle)*2" pos-y="-height+sin(angle)*2">
		<sprite texture="effects/lights/light2_L.png">
			<frame time="800">0 0 128 128</frame>
		</sprite>
		<looping value="true" />
		<length value="150" />
		<cast-shadows value="false" />
		<size value="40" />
		<color-r value="0.20" />
		<color-g value="0.16" />
		<color-b value="0.09" />
		<color-a value="0"/>
	</light>
</effect>
