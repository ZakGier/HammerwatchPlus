<!--
	A gun round: a small slug (bullet.png, tools/make_bullet_art.py) and a thin tracer,
	both tinted by the round. The slug is grey, so colr/colg/colb set its color (a param
	named r rendered the slug cyan: red 0, look-firearms-anims 20261019-124336); tr/tg/tb set the
	trail's and the glow's. A unit picks them in its behavior's effect-params, as it does
	height (the plain rounds are brass; an elemental round passes its element's color).
	Laid out as players/projectiles/crossbow_bolt.effect: shadow, slug, trail, light.
-->
<effect looping="true" wpos-track="3">
	<param name="angle" default="0" />
	<param name="height" default="0" />
	<param name="colr" default="1" />
	<param name="colg" default="0.86" />
	<param name="colb" default="0.55" />
	<param name="tr" default="1" />
	<param name="tg" default="0.8" />
	<param name="tb" default="0.45" />

	<sprite looping="true" origin="3 1.5" texture="./bullet.png" material="system/default.mats:shadow"
		pos-x="0"
		pos-y="+height"
		angle="angle">

		<frame time="60">0 0 6 3</frame>
		<frame time="60">0 3 6 3</frame>
	</sprite>
	<sprite looping="true" origin="3 1.5" texture="./bullet.png" material="system/default.mats:default"
		pos-x="0"
		pos-y="-height"
		angle="angle"
		color-r="colr"
		color-g="colg"
		color-b="colb">

		<frame time="60">0 0 6 3</frame>
		<frame time="60">0 3 6 3</frame>
	</sprite>

	<trail texture="special/empty.png" material="system/default.mats:default-simple">
		<pos-x value="wposx(i)+cos(angle)*-3" />
		<pos-y value="-height+(wposy(i))+sin(angle)*-3" />
		<angle value="angle"/>
		<length value="1000" />
		<looping value="true" />

		<segments value="3" />
		<size value="1.5-(0.4*i)" />

		<uv-x value="0" />
		<uv-y value="0" />

		<color-r value="tr" />
		<color-g value="tg" />
		<color-b value="tb" />
		<color-a value="0.45-i*(0.13)" />
	</trail>

	<light pos-x="cos(angle)*2" pos-y="-height+sin(angle)*2">
		<sprite texture="effects/lights/light2_L.png">
			<frame time="800">0 0 128 128</frame>
		</sprite>
		<looping value="true" />
		<length value="150" />
		<cast-shadows value="false" />
		<size value="40" />
		<color-r value="tr*0.2" />
		<color-g value="tg*0.2" />
		<color-b value="tb*0.2" />
		<color-a value="0"/>
	</light>
</effect>
