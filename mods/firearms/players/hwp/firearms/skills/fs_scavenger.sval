		<int name="skill-cost">SKILLCOSTLEVEL_1</int>
		<string name="class">Skills::PassiveSkill</string>
		<dict name="binds">
			<float name="ele-chance">0.1</float>
		</dict>
		<array name="modifiers">
			<array>
				<dict>
					<string name="class">Modifiers::CustomStat</string>
					<string name="name">hwp-ele-chance</string>
					<string name="add-bind">ele-chance</string>
				</dict>
			</array>
		</array>
	</dict>

