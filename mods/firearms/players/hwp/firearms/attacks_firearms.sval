						<string name="sound">event:/sfx/actors/humans/bandits/bandit_rogue/bandit_rogue_bomb_bounce</string>
						<float name="volume">1.4</float>
					</dict>
					%block Spend 1
					<dict>
						<string name="class">HWPFirearmsLowClick</string>
						<int name="low">3</int>
					</dict>
				</array>
			</dict>

			<array name="timeline">
				<i>0</i><s>shot1</s>
				<i>100</i><s>shot2</s>
				<i>200</i><s>shot3</s>
			</array>
		</dict>
	</dict>
