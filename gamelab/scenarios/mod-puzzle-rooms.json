{
 "name": "mod-puzzle-rooms",
 "about": "mods/puzzles in real level generation: with puzzles.room_chance 100 a keep floor (bandit_keep 0) places a keep_puzzle room, and with puzzles.constellation weighted up its PrefabPicker picks the HWP Constellation. Walk there, press the pattern stars: solved, and the room's RewardSpot (assigned at generation) drops its reward. Then no script errors in our files.",
 "fixture": "town-paladin",
 "mods": [
  "core",
  "puzzles"
 ],
 "timeout": 300,
 "steps": [
  {
   "do": "gl",
   "verb": "state",
   "expect": {
    "phase": "town"
   },
   "name": "still in town"
  },
  {
   "do": "gl",
   "verb": "mission",
   "args": [
    "story_intro_find_npcs",
    0
   ],
   "expect": {
    "ok": true
   },
   "name": "a first run (a new profile saves no town before one)"
  },
  {
   "do": "wait_phase",
   "phase": "mission",
   "timeout": 120
  },
  {
   "do": "console",
   "line": "e_cheats 1"
  },
  {
   "do": "console",
   "line": "cht_finish_level"
  },
  {
   "do": "wait_phase",
   "phase": "town",
   "timeout": 120
  },
  {
   "do": "sleep",
   "seconds": 3
  },
  {
   "do": "key",
   "key": "escape"
  },
  {
   "do": "sleep",
   "seconds": 1
  },
  {
   "do": "console",
   "line": "hwp set puzzles.room_chance 100"
  },
  {
   "do": "console",
   "line": "hwp set puzzles.constellation 100000"
  },
  {
   "do": "gl",
   "verb": "save",
   "expect": {
    "ok": true
   },
   "name": "town saved with the settings (a fixture boot has no town save, so the mission would load none)"
  },
  {
   "do": "gl",
   "verb": "mission",
   "args": [
    "bandit_keep",
    0
   ],
   "expect": {
    "ok": true
   }
  },
  {
   "do": "wait_phase",
   "phase": "mission",
   "timeout": 150
  },
  {
   "do": "log_has",
   "pattern": "\\[HWP:puzzles\\] puzzle rooms added to \\d+ mission level generator",
   "timeout": 5
  },
  {
   "do": "log_has",
   "pattern": "SpawnPrefabSet: keep_puzzle",
   "timeout": 5
  },
  {
   "do": "log_has",
   "pattern": "\\[HWP:puzzles\\] constellation picked \\(\\d+ vanilla candidates\\)",
   "timeout": 5
  },
  {
   "do": "console",
   "line": "e_cheats 1"
  },
  {
   "do": "console",
   "line": "hwp god"
  },
  {
   "do": "gl",
   "verb": "goto",
   "args": [
    "RewardSpot",
    "constellation",
    "0",
    "0"
   ],
   "expect": {
    "found": 1
   },
   "name": "walked to the generated room's constellation"
  },
  {
   "do": "sleep",
   "seconds": 1
  },
  {
   "do": "gl",
   "verb": "near",
   "args": [
    "48"
   ],
   "save_as": "before"
  },
  {
   "do": "gl",
   "verb": "ws",
   "args": [
    "Variable",
    "hwp_remaining"
   ],
   "expect": {
    "count": 1,
    "scripts.0.v": {
     "between": [
      7,
      12
     ]
    }
   },
   "name": "one constellation, a pattern picked"
  },
  {
   "do": "shot",
   "name": "room"
  },
  {
   "do": "gl",
   "verb": "usews",
